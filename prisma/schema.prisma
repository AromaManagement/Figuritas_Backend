generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  email        String      @unique
  phonenumber  String?
  passwordHash String      @map("password_hash")
  avatar       String?
  lat          Float?
  lng          Float?
  city         String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  cards        UserCard[]

  @@map("users")

  tradesRequested  Trade[]  @relation("TradeRequester")
  tradesReceived   Trade[]  @relation("TradeRecipient")
}

// Represents the relationship between a user and a sticker.
model UserCard {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  stickerId String  @map("sticker_id")  // references fullAlbum[].id
  quantity  Int     @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stickerId])
  @@map("user_cards")
}


model Trade {
  id                 String          @id @default(uuid())
  requestedStickerId String
  offeredStickerId   String[]       
  status             String     @default("ongoing")

  requesterId        Int
  requester          User     @relation("TradeRequester", fields: [requesterId], references: [id])

  recipientId        Int
  recipient          User     @relation("TradeRecipient", fields: [recipientId], references: [id])

  @@map("trades")
}